fft_result
apple = stft(raw_samplesAW, win = 1, inc = 1, coef= 1) #maximum window size is 128
apple
apple = stft(raw_samplesAW, win = 1, inc = 1, coef= 1, wtype = "rectangle.window") #maximum window size is 128
apple
